#!/bin/bash
# {{ ansible_managed }}
#
# certbot runs this after every successful issuance or renewal, with
# RENEWED_LINEAGE pointing at /etc/letsencrypt/live/<name>. It publishes the
# certificate to the paths existing consumers already read, so nothing else
# has to learn where certbot keeps things.
#
# Nobody watches this run. It fires from certbot-renew.timer roughly 30 days
# before expiry, so anything it gets wrong has a month to be noticed and will
# not be. Hence: verify before replacing, and fail loudly rather than half-way.
set -euo pipefail

FULLCHAIN="{{ certbot_deploy_fullchain }}"
KEY="{{ certbot_deploy_key }}"

NEW_CERT="${RENEWED_LINEAGE}/fullchain.pem"
NEW_KEY="${RENEWED_LINEAGE}/privkey.pem"

log() { printf '[certbot-deploy] %s\n' "$*"; }
die() { printf '[certbot-deploy] FATAL: %s\n' "$*" >&2; exit 1; }

# A mismatched pair would be published to httpd and handed to FreeIPA, taking
# down TLS on both at once. Cheap to check, so check.
#
# Compared by public key, not by modulus: a modulus exists only for RSA, so
# `openssl rsa -modulus` dies with "Not an RSA key" the moment anything issues
# an EC certificate -- which certbot 3.x does by default. `x509 -pubkey` and
# `pkey -pubout` are algorithm-agnostic and agree for both.
cert_pub=$(openssl x509 -noout -pubkey -in "${NEW_CERT}" | openssl md5)
key_pub=$(openssl pkey -pubout -in "${NEW_KEY}" | openssl md5)
[ "${cert_pub}" = "${key_pub}" ] || die "certificate and key do not match; refusing to publish"

install -o root -g root -m 0644 "${NEW_CERT}" "${FULLCHAIN}"
install -o root -g root -m 0600 "${NEW_KEY}"  "${KEY}"
log "published to ${FULLCHAIN}"

{% if certbot_ipa_dirsrv | bool %}
# --- FreeIPA directory server -------------------------------------------
#
# 389-ds serves :636 from an NSS database, which the PEM install above cannot
# touch. ipa-server-certinstall is the only thing that updates it, and it
# restarts dirsrv on success.
#
# The Directory Manager password goes in on stdin rather than through -p, so
# it never appears in ps. --pin= is empty because certbot writes an
# unencrypted PEM key; without it the command sits waiting on a prompt that
# will never be answered.
#
# ipa-server-certinstall REFUSES a chain whose CA is not already trusted by
# IPA, so the intermediates have to go in first -- see below.
DIRMAN_FILE="{{ certbot_ipa_dirman_file }}"
[ -r "${DIRMAN_FILE}" ] || die "${DIRMAN_FILE} missing; cannot reach the directory server"

# --- teach IPA any intermediate it has not met --------------------------
#
# Let's Encrypt hands out the issuing intermediate from a rotating pool: two
# certificates requested forty minutes apart came back signed by YR1 and then
# YR2. The R11/R12/R13 entries already in the trust store are the same thing,
# installed by hand over previous years. So an unseen intermediate is the
# ORDINARY case at renewal, not an exception, and leaving it manual means
# renewal stalls silently most times and stays stalled until expiry.
#
# What stays manual is a new ROOT. Adding an intermediate under a root IPA
# already trusts moves no trust boundary; accepting a new anchor does, and
# that is a decision for a person. This refuses to cross that line.
IPA_BUNDLE=/etc/ipa/ca.crt
work=$(mktemp -d)
trap 'rm -rf "${work}"' EXIT

: > "${work}/trusted.fp"
if [ -r "${IPA_BUNDLE}" ]; then
    awk -v d="${work}" '/BEGIN CERT/{c++} c{print > (d "/trusted-" c ".pem")}' "${IPA_BUNDLE}"
    for f in "${work}"/trusted-*.pem; do
        [ -e "${f}" ] || continue
        openssl x509 -noout -fingerprint -sha256 -in "${f}" 2>/dev/null | sed 's/.*=//' >> "${work}/trusted.fp"
    done
fi

awk -v d="${work}" '/BEGIN CERT/{c++} c{print > (d "/new-" c ".pem")}' "${NEW_CERT}"
topmost=$(find "${work}" -name 'new-*.pem' | sort -V | tail -1)

# The chain must still terminate in something IPA knows. Compared by subject
# rather than fingerprint because the root itself is not in certbot's chain --
# only the name of whoever signed the topmost link.
top_issuer=$(openssl x509 -noout -issuer -in "${topmost}" | sed 's/^issuer=//')
anchor_known=no
for f in "${work}"/trusted-*.pem; do
    [ -e "${f}" ] || continue
    if [ "$(openssl x509 -noout -subject -in "${f}" | sed 's/^subject=//')" = "${top_issuer}" ]; then
        anchor_known=yes
        break
    fi
done
[ "${anchor_known}" = yes ] || die "this chain terminates at '${top_issuer}', which IPA does not trust. That is a new trust anchor, not a rotated intermediate, and this hook will not install one on its own. See docs/freeipa-certificates.md. Nothing has been changed."

# ipa-cacert-manage is idempotent by certificate content -- re-installing one
# it already holds exits 0 without adding a duplicate nickname -- so the
# fingerprint test below is about not restarting things needlessly, and about
# saying in the log what actually changed.
installed_any=no
for f in $(find "${work}" -name 'new-*.pem' | sort -V | tail -n +2); do
    fp=$(openssl x509 -noout -fingerprint -sha256 -in "${f}" | sed 's/.*=//')
    grep -qxF "${fp}" "${work}/trusted.fp" && continue

    # Nickname from the CA's own CN, matching R11/R12/R13. The positional
    # INTERMEDIATE / INTERMEDIATE_2 names are the older mistake and say
    # nothing about what they hold.
    cn=$(openssl x509 -noout -subject -in "${f}" | sed 's/.*CN *= *//; s/,.*//' | tr -cd 'A-Za-z0-9_-')
    [ -n "${cn}" ] || die "could not derive a nickname for a new intermediate"

    log "IPA has not seen intermediate ${cn}; installing it"
    ipa-cacert-manage install "${f}" -n "${cn}" < "${DIRMAN_FILE}" \
        || die "could not install intermediate ${cn}; see docs/freeipa-certificates.md"
    installed_any=yes
done

if [ "${installed_any}" = yes ]; then
    log "refreshing the local certificate databases"
    ipa-certupdate || die "ipa-certupdate failed after installing a new intermediate"
else
    log "IPA already trusts this chain"
fi

log "installing into the FreeIPA directory server"
if ! ipa-server-certinstall -d "${KEY}" "${FULLCHAIN}" --pin= < "${DIRMAN_FILE}"; then
    die "ipa-server-certinstall failed. If it rejected the CA, Let's Encrypt \
rotated its chain and the manual steps in docs/freeipa-certificates.md are \
needed. dirsrv is untouched and still serving the previous certificate."
fi

# certinstall restarts dirsrv itself; confirm it actually came back rather
# than trusting the exit code, because everything on this host authenticates
# through it. Probed by FQDN rather than localhost on purpose: this box's
# ldap.conf happens to be lenient about hostname verification, so a localhost
# probe would prove only that the port answers. By name it also checks the
# certificate that was just installed is valid for the name clients use.
probe_ldaps() {
    ldapsearch -x -H "ldaps://{{ certbot_common_name }}" -s base -b "" vendorVersion >/dev/null 2>&1
}

for _ in $(seq 1 30); do
    if probe_ldaps; then
        log "directory server is answering on ldaps"
        break
    fi
    sleep 2
done
probe_ldaps || die "directory server did not come back after certinstall -- investigate now"
{% endif %}

{% for svc in certbot_reload_services %}
if systemctl is-active --quiet {{ svc }}; then
    systemctl reload {{ svc }} || systemctl restart {{ svc }}
    log "reloaded {{ svc }}"
fi
{% endfor %}

log "done"
